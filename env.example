# Flask
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# MySQL
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=cirs

# Gmail SMTP (use a Gmail App Password, not your normal password)
SMTP_EMAIL=your-sender@gmail.com
SMTP_APP_PASSWORD=your-16-character-app-password

# Department recipient emails
EMAIL_ELECTRICAL=department@example.com
EMAIL_MAINTENANCE=department@example.com
EMAIL_CSE=department@example.com
EMAIL_ECE=department@example.com
EMAIL_CLEANING=department@example.com
EMAIL_HOSTEL=department@example.com
EMAIL_OTHERS=department@example.com
EMAIL_LIBRARY=department@example.com

# Optional: JSON array of initial admin credentials.
# Example:
# ADMIN_DEFAULTS_JSON=[["electrical","CHANGE_ME","Electrical"],["maintenance","CHANGE_ME","Maintenance"]]
ADMIN_DEFAULTS_JSON=[]
